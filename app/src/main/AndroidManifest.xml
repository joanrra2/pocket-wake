<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talk to your MQTT broker. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Optional: read the board's setup QR code. Asked only when you tap Scan; frames stay on the phone. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.PocketWake">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The board's setup link (same as its QR code). The Pocket AdBlock app sends it
                 here directly; never carries a password. Not auto-verified, so browsers keep
                 opening it in the web app unless the user picks this app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="joanrra2.github.io" android:pathPrefix="/pocket-wake" />
            </intent-filter>
            <!-- Wake a PC from automation apps (Tasker, NFC tags): action ...WAKE with the
                 extra "name", or a pocketwake://wake/<name> link. Both ask before waking. -->
            <intent-filter>
                <action android:name="io.github.joanrra2.pocketwake.WAKE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pocketwake" android:host="wake" />
            </intent-filter>
        </activity>
    </application>
</manifest>
